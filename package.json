{
  "name": "trestleboard",
  "version": "1.0.0",
  "description": "AI-agnostic persona system for solution delivery",
  "main": "scripts/render.js",
  "bin": {
    "tb-render": "./scripts/render.js",
    "tb-init": "./scripts/init-project.js",
    "tb-validate": "./scripts/validate.js",
    "tb-lint": "./scripts/lint.js",
    "tb-customize": "./scripts/customize.js"
  },
  "scripts": {
    "render": "node scripts/render.js",
    "init": "node scripts/init-project.js",
    "validate": "node scripts/validate.js",
    "test": "node scripts/test-render.js && node scripts/test-validate.js && node scripts/test-init.js && node scripts/test-storage.js && node scripts/test-config.js && node scripts/test-helpers.js && node scripts/test-formatters.js && node scripts/test-cli.js && node scripts/test-personas.js && node scripts/test-customizations.js",
    "test:render": "node scripts/test-render.js",
    "test:validate": "node scripts/test-validate.js",
    "test:init": "node scripts/test-init.js",
    "test:storage": "node scripts/test-storage.js",
    "test:config": "node scripts/test-config.js",
    "test:helpers": "node scripts/test-helpers.js",
    "test:formatters": "node scripts/test-formatters.js",
    "test:cli": "node scripts/test-cli.js",
    "test:coverage": "c8 npm test",
    "test:coverage:report": "c8 --reporter=html npm test",
    "lint": "node scripts/lint.js",
    "customize": "node scripts/customize.js",
    "test:personas": "node scripts/test-personas.js",
    "test:customizations": "node scripts/test-customizations.js"
  },
  "keywords": [
    "ai",
    "personas",
    "agile",
    "inception-deck",
    "templates",
    "handlebars"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "c8": "^8.0.1"
  }
}
