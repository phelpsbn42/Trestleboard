{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trestleboard.local/schemas/inception-deck.schema.json",
  "title": "Inception Deck",
  "description": "Schema for Agile Inception Deck data",
  "type": "object",
  "required": ["project_name", "generated_date"],
  "properties": {
    "project_name": {
      "type": "string",
      "description": "Name of the project"
    },
    "generated_date": {
      "type": "string",
      "format": "date",
      "description": "Date the deck was generated"
    },
    "section_1_why_are_we_here": {
      "type": "object",
      "description": "Section 1: Why Are We Here?",
      "properties": {
        "problem_statement": {
          "type": "string"
        },
        "affected_parties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "current_state": {
          "type": "string"
        },
        "consequences": {
          "type": "array",
          "items": { "type": "string" }
        },
        "success_vision": {
          "type": "string"
        },
        "success_criteria": {
          "type": "array",
          "items": { "type": "string" }
        },
        "key_drivers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "driver": { "type": "string" },
              "rationale": { "type": "string" }
            }
          }
        },
        "open_questions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "section_2_elevator_pitch": {
      "type": "object",
      "description": "Section 2: Elevator Pitch",
      "properties": {
        "target_customer": { "type": "string" },
        "target_customer_detail": { "type": "string" },
        "customer_need": { "type": "string" },
        "customer_need_detail": { "type": "string" },
        "product_name": { "type": "string" },
        "product_category": { "type": "string" },
        "key_benefit": { "type": "string" },
        "key_benefit_detail": { "type": "string" },
        "competitors": { "type": "string" },
        "competitors_list": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "weakness": { "type": "string" }
            }
          }
        },
        "differentiator": { "type": "string" },
        "differentiator_detail": { "type": "string" },
        "taglines": {
          "type": "array",
          "items": { "type": "string" }
        },
        "urgency": { "type": "string" },
        "open_questions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "section_3_product_box": {
      "type": "object",
      "description": "Section 3: Product Box",
      "properties": {
        "product_name": { "type": "string" },
        "tagline": { "type": "string" },
        "hero_image_description": { "type": "string" },
        "top_features": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "headline": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "product_description": { "type": "string" },
        "key_benefits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "icon": { "type": "string" },
              "benefit": { "type": "string" },
              "detail": { "type": "string" }
            }
          }
        },
        "technical_highlights": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requirements": {
          "type": "array",
          "items": { "type": "string" }
        },
        "version": { "type": "string" },
        "platform": { "type": "string" },
        "license": { "type": "string" },
        "support": { "type": "string" },
        "testimonial_quote": { "type": "string" },
        "testimonial_author": { "type": "string" },
        "testimonial_role": { "type": "string" },
        "call_to_action": { "type": "string" },
        "open_questions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "section_4_not_list": {
      "type": "object",
      "description": "Section 4: NOT List",
      "properties": {
        "not_doing": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": { "type": "string" },
              "rationale": { "type": "string" },
              "misconception": { "type": "string" }
            }
          }
        },
        "not_now": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": { "type": "string" },
              "rationale": { "type": "string" },
              "timeline": { "type": "string" },
              "dependencies": { "type": "string" }
            }
          }
        },
        "in_scope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "excluded_users": {
          "type": "array",
          "items": { "type": "string" }
        },
        "excluded_platforms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "excluded_integrations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "excluded_features": {
          "type": "array",
          "items": { "type": "string" }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": { "type": "string" },
              "decision": { "type": "string" },
              "date": { "type": "string" },
              "decided_by": { "type": "string" }
            }
          }
        },
        "escalation_contact": { "type": "string" },
        "open_questions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "section_5_meet_neighbors": {
      "type": "object",
      "description": "Section 5: Meet the Neighbors",
      "properties": {
        "core_team": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "responsibilities": { "type": "string" },
              "availability": { "type": "string" },
              "contact": { "type": "string" }
            }
          }
        },
        "key_stakeholders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "title": { "type": "string" },
              "interest": { "type": "string" },
              "influence": { "type": "string" },
              "engagement": { "type": "string" },
              "concerns": { "type": "string" },
              "comm_preference": { "type": "string" }
            }
          }
        },
        "stakeholder_matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "interest": { "type": "string" },
              "influence": { "type": "string" },
              "strategy": { "type": "string" }
            }
          }
        },
        "dependent_teams": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "team_name": { "type": "string" },
              "dependency": { "type": "string" },
              "contact": { "type": "string" },
              "risk": { "type": "string" }
            }
          }
        },
        "consuming_teams": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "team_name": { "type": "string" },
              "dependency": { "type": "string" },
              "contact": { "type": "string" },
              "timeline": { "type": "string" }
            }
          }
        },
        "external_systems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "system_name": { "type": "string" },
              "integration_type": { "type": "string" },
              "owner": { "type": "string" },
              "sla": { "type": "string" },
              "docs_link": { "type": "string" }
            }
          }
        },
        "communication_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "audience": { "type": "string" },
              "frequency": { "type": "string" },
              "channel": { "type": "string" },
              "content": { "type": "string" },
              "owner": { "type": "string" }
            }
          }
        },
        "raci": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "area": { "type": "string" },
              "responsible": { "type": "string" },
              "accountable": { "type": "string" },
              "consulted": { "type": "string" },
              "informed": { "type": "string" }
            }
          }
        },
        "potential_blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "blocker": { "type": "string" },
              "mitigation": { "type": "string" }
            }
          }
        },
        "open_questions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "section_6_show_solution": {
      "type": "object",
      "description": "Section 6: Show the Solution",
      "properties": {
        "solution_overview": { "type": "string" },
        "solution_diagram": { "type": "string" },
        "solution_diagram_description": { "type": "string" },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "purpose": { "type": "string" },
              "technology": { "type": "string" },
              "interactions": { "type": "string" }
            }
          }
        },
        "user_journeys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "journey_name": { "type": "string" },
              "actor": { "type": "string" },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "number": { "type": "integer" },
                    "description": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "architecture_style": { "type": "string" },
        "technologies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": { "type": "string" },
              "choice": { "type": "string" },
              "rationale": { "type": "string" }
            }
          }
        },
        "data_flow_description": { "type": "string" },
        "data_flow_diagram": { "type": "string" },
        "integrations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "system_name": { "type": "string" },
              "method": { "type": "string" },
              "data": { "type": "string" },
              "frequency": { "type": "string" },
              "error_handling": { "type": "string" }
            }
          }
        },
        "security_considerations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "area": { "type": "string" },
              "approach": { "type": "string" }
            }
          }
        },
        "scalability_approach": { "type": "string" },
        "expected_users": { "type": "string" },
        "expected_transactions": { "type": "string" },
        "expected_data_volume": { "type": "string" },
        "deployment_model": { "type": "string" },
        "environments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "purpose": { "type": "string" }
            }
          }
        },
        "open_questions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "section_7_risks": {
      "type": "object",
      "description": "Section 7: Risks",
      "properties": {
        "risks_summary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "likelihood": { "type": "integer", "minimum": 1, "maximum": 5 },
              "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
              "score": { "type": "integer" },
              "status": { "type": "string" }
            }
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "category": { "type": "string" },
              "description": { "type": "string" },
              "likelihood": { "type": "integer" },
              "likelihood_rationale": { "type": "string" },
              "impact": { "type": "integer" },
              "impact_rationale": { "type": "string" },
              "score": { "type": "integer" },
              "risk_level": { "type": "string" },
              "triggers": { "type": "array", "items": { "type": "string" } },
              "mitigation": { "type": "string" },
              "contingency": { "type": "string" },
              "owner": { "type": "string" },
              "status": { "type": "string" },
              "review_date": { "type": "string" }
            }
          }
        },
        "technical_risks": { "type": "array", "items": { "type": "string" } },
        "schedule_risks": { "type": "array", "items": { "type": "string" } },
        "resource_risks": { "type": "array", "items": { "type": "string" } },
        "external_risks": { "type": "array", "items": { "type": "string" } },
        "business_risks": { "type": "array", "items": { "type": "string" } },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "assumption": { "type": "string" },
              "consequence": { "type": "string" }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dependency": { "type": "string" },
              "owner": { "type": "string" },
              "risk": { "type": "string" }
            }
          }
        },
        "next_review_date": { "type": "string" },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "section_8_sizing": {
      "type": "object",
