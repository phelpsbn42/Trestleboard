{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trestleboard.local/schemas/specification.schema.json",
  "title": "Specification",
  "description": "Schema for technical specification artifacts",
  "type": "object",
  "required": ["project_name", "generated_date"],
  "properties": {
    "project_name": {
      "type": "string",
      "description": "Name of the project"
    },
    "generated_date": {
      "type": "string",
      "format": "date",
      "description": "Date the specification was generated"
    },
    "assumptions": {
      "type": "array",
      "description": "Documented assumptions made during design",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Unique identifier (e.g., ASSUMP-001)" },
          "description": { "type": "string", "description": "Clear statement of the assumption" },
          "source": { "type": "string", "description": "Where this assumption originated" },
          "impact_if_wrong": { "type": "string", "description": "Consequences if assumption proves false" },
          "validation_plan": { "type": "string", "description": "How and when this will be validated" },
          "status": { "type": "string", "enum": ["Unvalidated", "Validated", "Invalidated"] }
        },
        "required": ["id", "description", "status"]
      }
    },
    "technology_stack": {
      "type": "array",
      "description": "Summary of key technologies",
      "items": {
        "type": "object",
        "properties": {
          "layer": { "type": "string", "description": "Architecture layer (Frontend, Backend, Database, etc.)" },
          "technology": { "type": "string", "description": "Technology name" },
          "version": { "type": "string", "description": "Version or version range" },
          "rationale": { "type": "string", "description": "Why this technology was selected" }
        },
        "required": ["layer", "technology"]
      }
    },
    "technology_details": {
      "type": "array",
      "description": "Detailed information about each technology choice",
      "items": {
        "type": "object",
        "properties": {
          "technology": { "type": "string" },
          "layer": { "type": "string" },
          "version": { "type": "string" },
          "license": { "type": "string" },
          "rationale": { "type": "string" },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "reason_rejected": { "type": "string" }
              }
            }
          },
          "risks": { "type": "array", "items": { "type": "string" } },
          "team_readiness": { "type": "string" }
        }
      }
    },
    "architectural_patterns": {
      "type": "array",
      "description": "Architectural patterns applied to the solution",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Pattern name (e.g., CQRS, Repository, MVC)" },
          "category": { "type": "string", "description": "Pattern category (Structural, Data, Integration, Behavioral)" },
          "where_applied": { "type": "string", "description": "Which component/layer uses this pattern" },
          "problem_solved": { "type": "string", "description": "What challenge this addresses" },
          "implementation_notes": { "type": "string", "description": "How it will be implemented" },
          "benefits": { "type": "string", "description": "Benefits gained" },
          "complexity": { "type": "string", "description": "Complexity added" },
          "references": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["name", "where_applied", "problem_solved"]
      }
    },
    "use_cases": {
      "type": "object",
      "description": "Use case documentation",
      "properties": {
        "actors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["Primary", "Secondary", "System"] },
              "description": { "type": "string" },
              "goals": { "type": "string" }
            }
          }
        },
        "use_cases_summary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "actor": { "type": "string" },
              "priority": { "type": "string" }
            }
          }
        },
        "use_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "primary_actor": { "type": "string" },
              "priority": { "type": "string" },
              "complexity": { "type": "string" },
              "status": { "type": "string" },
              "source": { "type": "string" },
              "description": { "type": "string" },
              "preconditions": { "type": "array", "items": { "type": "string" } },
              "postconditions_success": { "type": "array", "items": { "type": "string" } },
              "postconditions_failure": { "type": "array", "items": { "type": "string" } },
              "triggers": { "type": "array", "items": { "type": "string" } },
              "main_scenario": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "step": { "type": "integer" },
                    "actor_action": { "type": "string" },
                    "system_response": { "type": "string" }
                  }
                }
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "condition": { "type": "string" },
                    "steps": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "step": { "type": "string" },
                          "description": { "type": "string" }
                        }
                      }
                    },
                    "rejoin_step": { "type": "integer" }
                  }
                }
              },
              "exceptions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "condition": { "type": "string" },
                    "handler_steps": { "type": "array", "items": { "type": "string" } },
                    "outcome": { "type": "string" }
                  }
                }
              },
              "business_rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "rule_id": { "type": "string" },
                    "description": { "type": "string" }
                  }
                }
              },
              "data_requirements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": { "type": "string" },
                    "type": { "type": "string" },
                    "constraints": { "type": "string" }
                  }
                }
              },
              "ui_notes": { "type": "string" },
              "nfr": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "category": { "type": "string" },
                    "requirement": { "type": "string" }
                  }
                }
              },
              "open_questions": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": { "type": "string" },
              "target": { "type": "string" }
            }
          }
        },
        "extends": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "extension": { "type": "string" },
              "base": { "type": "string" },
              "condition": { "type": "string" }
            }
          }
        },
        "generalizations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "specific": { "type": "string" },
              "general": { "type": "string" }
            }
          }
        },
        "traceability": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "use_case": { "type": "string" },
              "inception_section": { "type": "string" },
              "requirement_id": { "type": "string" }
            }
          }
        }
      }
    },
    "c4_context": {
      "type": "object",
      "description": "C4 Context Diagram data",
      "properties": {
        "system_id": { "type": "string" },
        "system_name": { "type": "string" },
        "system_description": { "type": "string" },
        "system_responsibilities": { "type": "array", "items": { "type": "string" } },
        "system_interfaces": { "type": "array", "items": { "type": "string" } },
        "persons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "type": { "type": "string" },
              "description": { "type": "string" },
              "goals": { "type": "array", "items": { "type": "string" } },
              "interactions": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "external_systems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "type": { "type": "string" },
              "owner": { "type": "string" },
              "description": { "type": "string" },
              "integration_purpose": { "type": "string" },
              "data_exchanged": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "direction": { "type": "string" },
                    "data": { "type": "string" }
                  }
                }
              },
              "integration_method": { "type": "string" },
              "sla": { "type": "string" },
              "documentation_link": { "type": "string" }
            }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "description": { "type": "string" },
              "technology": { "type": "string" }
            }
          }
        },
        "inside_boundary": { "type": "array", "items": { "type": "string" } },
        "outside_boundary": { "type": "array", "items": { "type": "string" } },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "c4_container": {
      "type": "object",
      "description": "C4 Container Diagram data",
      "properties": {
        "system_id": { "type": "string" },
        "system_name": { "type": "string" },
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "type": { "type": "string" },
              "technology": { "type": "string" },
              "description": { "type": "string" },
              "responsibilities": { "type": "array", "items": { "type": "string" } },
              "interfaces": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "protocol": { "type": "string" },
                    "description": { "type": "string" }
                  }
                }
              },
              "scaling_strategy": { "type": "string" },
              "deployment": { "type": "string" }
            }
          }
        },
        "databases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "technology": { "type": "string" },
              "db_type": { "type": "string" },
              "description": { "type": "string" },
              "data_stored": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "entity": { "type": "string" },
                    "description": { "type": "string" }
                  }
                }
              },
              "initial_size": { "type": "string" },
              "growth_rate": { "type": "string" },
              "retention": { "type": "string" },
              "backup_strategy": { "type": "string" }
            }
          }
        },
        "queues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "technology": { "type": "string" },
              "description": { "type": "string" },
              "message_types": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "description": { "type": "string" }
                  }
                }
              },
              "throughput": { "type": "string" },
              "retention": { "type": "string" }
            }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "description": { "type": "string" },
              "technology": { "type": "string" }
            }
          }
        },
        "tech_stack": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "layer": { "type": "string" },
              "technology": { "type": "string" },
              "version": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        },
        "security_boundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "protection": { "type": "string" },
              "components": { "type": "string" }
            }
          }
        },
        "authentication": { "type": "string" },
        "authorization": { "type": "string" },
        "logging": { "type": "string" },
        "monitoring": { "type": "string" },
        "error_handling": { "type": "string" },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "c4_components": {
      "type": "array",
      "description": "C4 Component Diagrams (one per container)",
      "items": {
        "type": "object",
        "properties": {
          "container_id": { "type": "string" },
          "container_name": { "type": "string" },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "technology": { "type": "string" },
                "layer": { "type": "string" },
                "description": { "type": "string" },
                "responsibilities": { "type": "array", "items": { "type": "string" } },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "component": { "type": "string" },
                      "purpose": { "type": "string" }
                    }
                  }
                },
                "interfaces_provided": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string" },
                      "type": { "type": "string" },
                      "description": { "type": "string" }
                    }
                  }
                },
                "interfaces_consumed": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "component": { "type": "string" },
                      "interface": { "type": "string" },
                      "purpose": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "where": { "type": "string" },
                "rationale": { "type": "string" },
                "components": { "type": "string" }
              }
            }
          },
          "key_flows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "sequence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "step": { "type": "integer" },
                      "from": { "type": "string" },
                      "to": { "type": "string" },
                      "action": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "open_questions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "wireframes": {
      "type": "object",
      "description": "Wireframe documentation",
      "properties": {
        "navigation_structure": { "type": "string" },
        "screens_summary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "use_case": { "type": "string" },
              "priority": { "type": "string" }
            }
          }
        },
        "wireframes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "purpose": { "type": "string" },
              "related_use_cases": { "type": "array", "items": { "type": "string" } },
              "ascii_wireframe": { "type": "string" },
              "layout_description": { "type": "string" },
              "elements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "type": { "type": "string" },
                    "description": { "type": "string" },
                    "behavior": { "type": "string" }
                  }
                }
              },
              "interactions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "trigger": { "type": "string" },
                    "action": { "type": "string" },
                    "result": { "type": "string" }
                  }
                }
              },
              "validation_rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": { "type": "string" },
                    "rule": { "type": "string" }
                  }
                }
              },
              "accessibility": { "type": "array", "items": { "type": "string" } },
              "responsive": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "breakpoint": { "type": "string" },
                    "changes": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "common_components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "visual": { "type": "string" },
              "variants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "description": { "type": "string" }
                  }
                }
              },
              "props": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "type": { "type": "string" },
                    "required": { "type": "boolean" },
                    "description": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "user_flows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "number": { "type": "integer" },
                    "screen": { "type": "string" },
                    "action": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "design_tokens": {
          "type": "object",
          "properties": {
            "colors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "value": { "type": "string" },
                  "usage": { "type": "string" }
                }
              }
            },
            "typography": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "value": { "type": "string" },
                  "usage": { "type": "string" }
                }
              }
            },
            "spacing": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "value": { "type": "string" },
                  "usage": { "type": "string" }
                }
              }
            }
          }
        },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "adrs": {
      "type": "array",
      "description": "Architectural Decision Records",
      "items": {
        "type": "object",
        "properties": {
          "adr_number": { "type": "integer" },
          "title": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "status": { "type": "string", "enum": ["Proposed", "Accepted", "Deprecated", "Superseded"] },
          "context": { "type": "string" },
          "problem_statement": { "type": "string" },
          "forces": { "type": "array", "items": { "type": "string" } },
          "constraints": { "type": "array", "items": { "type": "string" } },
          "decision_drivers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "driver": { "type": "string" },
                "importance": { "type": "string" }
              }
            }
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": { "type": "integer" },
                "name": { "type": "string" },
                "description": { "type": "string" },
                "pros": { "type": "array", "items": { "type": "string" } },
                "cons": { "type": "array", "items": { "type": "string" } },
                "cost": { "type": "string" },
                "risk": { "type": "string" }
              }
            }
          },
          "chosen_option": { "type": "string" },
          "rationale": { "type": "string" },
          "positive_consequences": { "type": "array", "items": { "type": "string" } },
          "negative_consequences": { "type": "array", "items": { "type": "string" } },
          "neutral_consequences": { "type": "array", "items": { "type": "string" } },
          "implementation_approach": { "type": "string" },
          "implementation_tasks": { "type": "array", "items": { "type": "string" } },
          "implementation_timeline": { "type": "string" },
          "success_metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "metric": { "type": "string" },
                "target": { "type": "string" }
              }
            }
          },
          "review_date": { "type": "string" },
          "related_adrs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": { "type": "integer" },
                "title": { "type": "string" },
                "relationship": { "type": "string" }
              }
